<% layout("/layouts/boilerplate.ejs") %>

  <div class="artisanal-form-hero">
    <div class="master-form-card host-form-card">
      <div class="form-header-main">
        <h2>Become a Host</h2>
        <p>Share your artisanal space with the world</p>
      </div>

      <form action="/listings" method="POST" class="needs-validation" novalidate enctype="multipart/form-data">

        <!-- Property Name — full width -->
        <div class="artisanal-field-group">
          <label for="title" class="field-label-artisanal">Property Name</label>
          <input type="text" name="listing[title]" id="title" class="field-control-artisanal"
            placeholder="e.g. Minimalist Forest Cabin" required>
        </div>

        <!-- Story — full width -->
        <div class="artisanal-field-group">
          <label for="description" class="field-label-artisanal">The Story</label>
          <textarea name="listing[description]" id="description" class="field-control-artisanal" rows="3"
            placeholder="Describe the atmosphere and unique details..." required></textarea>
        </div>

        <!-- Cover Image — full width -->
        <div class="artisanal-field-group ">
          <label for="image" class="field-label-artisanal">Cover Image URL</label>
          <input type="file" name="listing[image][url]" id="image" class="field-control-artisanal form-control"
            placeholder="https://unsplash.com/photos/...">
        </div>

        <!-- Price + Country — share one row -->
        <div class="field-row-split">
          <div class="artisanal-field-group">
            <label for="price" class="field-label-artisanal">Nightly Price (₹)</label>
            <input type="number" name="listing[price]" id="price" class="field-control-artisanal"
              placeholder="e.g. 4500" required>
          </div>
          <div class="artisanal-field-group">
            <label for="country" class="field-label-artisanal">Country</label>
            <input type="text" name="listing[country]" id="country" class="field-control-artisanal"
              placeholder="e.g. India" required>
          </div>
        </div>

        <!-- Specific Location — full width -->
        <div class="artisanal-field-group" style="margin-bottom: 2.5rem;">
          <label for="location" class="field-label-artisanal">Specific Location</label>
          <input type="text" name="listing[location]" id="location" class="field-control-artisanal"
            placeholder="e.g. Manali, Himachal Pradesh" required>
        </div>

        <!-- Publish + Cancel — share one row -->
        <div class="field-row-split" style="margin-bottom:0;">
          <button type="submit" class="form-submit-btn full-width">Publish Listing</button>
          <a href="/listings" class="form-cancel-btn full-width">Cancel</a>
        </div>

      </form>
    </div>
  </div>