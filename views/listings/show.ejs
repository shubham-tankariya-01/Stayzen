<% layout("/layouts/boilerplate.ejs") %>

  <!-- ===== Full-width listing detail ===== -->
  <div class="container-artisanal">

    <div class="master-card-container">
      <img src="<%=listing.image.url%>" class="master-card-image" alt="<%= listing.title %>" />

      <div class="master-info-area">
        <div class="master-header-row">
          <div class="master-title-box">
            <h1 class="master-title">
              <%= listing.title %>
            </h1>
            <div class="master-location">
              <i class="fa-solid fa-location-arrow"></i>
              <%= listing.location %>, <%= listing.country %>
            </div>
          </div>
          <div class="master-price-box">
            <span class="text-muted small d-block mb-1 font-monospace fw-bold letter-spacing-1">RATE / NIGHT</span>
            <div class="master-price-large">&#8377; <%= listing.price.toLocaleString("en-IN") %>
            </div>
          </div>
        </div>

        <div class="master-detail-grid">
          <div class="master-desc-area">
            <p class="mb-4">
              <%= listing.description %>
            </p>
            <% if (typeof currentUser !== 'undefined' && currentUser && listing.owner && listing.owner._id.equals(currentUser._id)) { %>
              <div class="master-actions-bar">
                <a href="/listings/<%= listing._id %>/edit" class="btn-premium-soft rounded-pill px-4"
                  style="text-decoration: none; text-align: center; display: flex; justify-content: center; align-items: center;">Edit
                  Listing</a>
                <form action="/listings/<%= listing._id %>?_method=delete" method="post">
                  <button class="btn rounded-pill px-4 fw-bold"
                    style="background:#fef2f2;color:#ef4444;border:1.5px solid #fee2e2;">Delete Listing</button>
                </form>
              </div>
              <% } %>
          </div>

          <div class="master-sidebar">
            <div class="master-host-box">
              <div class="user-avatar-pill" style="width:48px;height:48px;font-size:1rem;">
                <%= listing.owner ? listing.owner.username[0].toUpperCase() : '?' %>
              </div>
              <div>
                <span class="text-muted x-small d-block text-uppercase fw-900 letter-spacing-1">Hosted by</span>
                <span class="fw-bold fs-5">
                  <%= listing.owner ? listing.owner.username : 'Unknown Host' %>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- ===== Write a Review (at the bottom) ===== -->
    <div class="master-leave-review-area mt-5 px-4">
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <h3 class="fw-900 mb-2" style="font-size:1.4rem;letter-spacing:-0.5px;">Seal the memory</h3>
        <p class="text-muted mb-4" style="font-size:0.9rem;">Your perspective adds value to this artisanal sanctuary.
        </p>

        <form method="post" action="/listings/<%= listing._id %>/reviews" class="needs-validation" novalidate>
          <div class="mb-3">
            <fieldset class="starability-heartbeat shadow-none ms-0">
              <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked
                aria-label="No rating." />
              <input type="radio" id="first-rate1" name="review[rating]" value="1" />
              <label for="first-rate1" title="Terrible">1 star</label>
              <input type="radio" id="first-rate2" name="review[rating]" value="2" />
              <label for="first-rate2" title="Not good">2 stars</label>
              <input type="radio" id="first-rate3" name="review[rating]" value="3" />
              <label for="first-rate3" title="Average">3 stars</label>
              <input type="radio" id="first-rate4" name="review[rating]" value="4" />
              <label for="first-rate4" title="Very good">4 stars</label>
              <input type="radio" id="first-rate5" name="review[rating]" value="5" />
              <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
          </div>
          <div class="mb-4">
            <textarea name="review[comment]" class="form-control border-0 shadow-none p-4" rows="4"
              placeholder="Distill your experience into words..." required
              style="border-radius:var(--radius-lg);background:#eef3f9;color:var(--color-text-main);font-size:0.95rem;border:2px solid #e2e8f0;resize:none;"></textarea>
          </div>
          <!-- Smaller publish button -->
          <button class="form-submit-btn" style="padding: 0.75rem 2rem; font-size: 0.85rem;">Publish Entry</button>
        </form>
        <% } else { %>
          <div class="text-center py-4">
            <h3 class="fw-900 mb-2" style="font-size:1.4rem;">Join the conversation</h3>
            <p class="text-muted mb-4" style="font-size:0.9rem;">A memory shared is a legacy preserved. Sign in to
              leave your mark.</p>
            <a href="/login" class="form-submit-btn text-decoration-none">Sign in to Review</a>
          </div>
          <% } %>
    </div>

    <!-- ===== Guest Log (reviews) ===== -->
    <div class="master-reviews-section px-4">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-900 fs-1">Guest Log</h2>
        <div class="px-3 py-1 rounded-pill x-small fw-800"
          style="background:#f1f5f9;border:1px solid #e2e8f0;color:var(--color-primary);">
          <%= listing.reviews.length %> ENTRIES
        </div>
      </div>

      <div class="master-review-grid">
        <% if (listing.reviews.length===0) { %>
          <div class="text-muted opacity-40 fs-5 italic py-2">Silence is the only guest here. Be the first to speak.
          </div>
          <% } %>
            <% for(let review of listing.reviews){ %>
              <div class="artisanal-review-tile">
                <!-- Header: avatar + name + stars -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                  <div class="d-flex align-items-center gap-2">
                    <div class="user-avatar-pill"
                      style="width:28px;height:28px;background:#f1f5f9;color:var(--color-primary);font-size:0.8rem;border:1px solid #e2e8f0;">
                      <%= review.author ? review.author.username[0].toUpperCase() : '?' %>
                    </div>
                    <span class="fw-bold" style="font-size:0.9rem;">
                      <%= review.author ? review.author.username : 'Unknown' %>
                    </span>
                  </div>
                  <div class="starability-result" data-rating="<%= review.rating %>"
                    style="transform:scale(0.45);transform-origin:right;"></div>
                </div>

                <!-- Clamped comment -->
                <p class="review-comment-clamped text-muted">
                  <%= review.comment %>
                </p>

                <!-- Delete (author only) — simple text link, no circle -->
                <% if (typeof currentUser !== 'undefined' && currentUser && review.author && review.author._id.equals(currentUser._id)) { %>
                  <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=delete" method="post"
                    class="review-delete-form">
                    <button type="submit" class="review-delete-link review-delete-btn">
                      <i class="fa-solid fa-trash-can"></i>
                      <span>Delete</span>
                    </button>
                  </form>
                  <% } %>
              </div>
              <% } %>
      </div>


    </div>
  </div>