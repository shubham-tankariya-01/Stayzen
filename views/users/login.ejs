<% layout("/layouts/boilerplate.ejs") %>

  <div class="artisanal-form-hero">
    <div class="master-form-card">
      <div class="form-header-main">
        <h2>Welcome back</h2>
        <p>Enter your details to continue your journey</p>
      </div>

      <form action="/login" method="POST" class="needs-validation" novalidate>
        <div class="artisanal-field-group">
          <label for="username" class="field-label-artisanal">Username</label>
          <input type="text" name="username" id="username" class="field-control-artisanal" placeholder="Your identifier"
            required>
        </div>

        <div class="artisanal-field-group" style="margin-bottom: 2rem;">
          <label for="password" class="field-label-artisanal">Password</label>
          <input type="password" name="password" id="password" class="field-control-artisanal" placeholder="••••••••"
            required>
        </div>

        <button type="submit" class="form-submit-btn full-width">Sign in</button>
      </form>

      <div class="form-footer-secondary">
        Don't have an account? <a href="/signup">Join Stayzen</a>
      </div>
    </div>
  </div>