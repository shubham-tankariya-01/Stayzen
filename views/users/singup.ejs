<% layout("/layouts/boilerplate.ejs") %>

  <div class="artisanal-form-hero">
    <div class="master-form-card">
      <div class="form-header-main">
        <h2>Join Stayzen</h2>
        <p>Begin your artisanal journey today</p>
      </div>

      <form action="/signup" method="post" class="needs-validation" novalidate>

        <!-- First Name + Last Name in one row -->
        <div class="field-row-split">
          <div class="artisanal-field-group">
            <label for="firstName" class="field-label-artisanal">First Name</label>
            <input type="text" id="firstName" name="userInfo[firstName]" class="field-control-artisanal"
              placeholder="e.g. Jane" required />
          </div>
          <div class="artisanal-field-group">
            <label for="lastName" class="field-label-artisanal">Last Name</label>
            <input type="text" id="lastName" name="userInfo[lastName]" class="field-control-artisanal"
              placeholder="e.g. Doe" required />
          </div>
        </div>

        <!-- Username + DOB in one row -->
        <div class="field-row-split">
          <div class="artisanal-field-group">
            <label for="username" class="field-label-artisanal">Username</label>
            <input type="text" id="username" name="username" class="field-control-artisanal" placeholder="StayzenMaster"
              required />
          </div>
          <div class="artisanal-field-group">
            <label for="dateOfBirth" class="field-label-artisanal">Date of Birth</label>
            <input type="date" id="dateOfBirth" name="userInfo[dateOfBirth]" class="field-control-artisanal" required />
          </div>
        </div>

        <!-- Email — full width -->
        <div class="artisanal-field-group">
          <label for="email" class="field-label-artisanal">Email</label>
          <input type="email" id="email" name="email" class="field-control-artisanal" placeholder="artisan@stayzen.com"
            required />
        </div>

        <!-- Password — full width -->
        <div class="artisanal-field-group" style="margin-bottom: 2rem;">
          <label for="password" class="field-label-artisanal">Password</label>
          <input type="password" id="password" name="password" class="field-control-artisanal" placeholder="••••••••"
            required />
        </div>

        <button type="submit" class="form-submit-btn full-width">Create Account</button>
      </form>

      <div class="form-footer-secondary">
        Already a member? <a href="/login">Sign in</a>
      </div>
    </div>
  </div>